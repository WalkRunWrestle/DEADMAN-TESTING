    function scrollToDeadmanMap(){
      const mapShell = document.getElementById("deadmanMapShell");
      const routeCard = mapShell ? mapShell.closest(".route-card") : null;
      const target = routeCard || mapShell;
      if (!target) return;

      const rect = target.getBoundingClientRect();
      const currentScroll = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
      const targetTop = Math.max(currentScroll + rect.top - 12, 0);

      window.scrollTo({ top: targetTop, behavior: "smooth" });
    }

    function playMapFillAnimation(fromKm, toKm){
      const mapShell = document.getElementById("deadmanMapShell");
      const haloPath = document.getElementById("routeFillHalo");
      const snakeMarker = document.getElementById("snakeMarker");
      const paths = [routeFillPath, haloPath].filter(Boolean);

      // Freeze the map at the OLD distance first so the runner sees the fill happen.
      paths.forEach(p => {
        p.style.transition = "none";
      });
      if (snakeMarker) snakeMarker.style.transition = "none";
      updateRouteVisual(fromKm);

      // Force browser to paint the old state before we scroll/animate.
      void document.body.offsetHeight;

      // Move the runner back to the map before the route starts filling.
      scrollToDeadmanMap();
      if (mapShell) mapShell.classList.remove("map-animating");

      // Start fill after the scroll has had time to land.
      window.setTimeout(() => {
        if (mapShell) mapShell.classList.add("map-animating");

        paths.forEach(p => {
          p.style.transition = "stroke-dashoffset 2.25s cubic-bezier(.18,.82,.25,1)";
        });
        if (snakeMarker) {
          snakeMarker.style.transition = "transform 2.25s cubic-bezier(.18,.82,.25,1)";
        }

        updateRouteVisual(toKm);

        window.setTimeout(() => {
          if (mapShell) mapShell.classList.remove("map-animating");
        }, 2600);
      }, 1150);
    }

    async function addRun(){
      const previousTotalKm = getTotalKm();
      const distanceKm = Number(manualDistanceInput.value);
      const selectedDate = manualDateInput.value;

      if (!distanceKm || distanceKm <= 0){
        alert("Enter a valid distance.");
        return;
      }

      if (!selectedDate){
        alert("Select a date for this run.");
        return;
      }

      const sessions = getSessions();
      sessions.push({
        date: new Date(selectedDate + "T12:00:00").toISOString(),
        distanceKm
      });
      saveSessions(sessions);

      const newTotalKm = getTotalKm();
      addSyncDebug("distance added", distanceKm.toFixed(2) + " km");
      addSyncDebug("new local total", newTotalKm.toFixed(2) + " km");

      manualDistanceInput.value = "";
      manualDateInput.value = new Date().toISOString().split("T")[0];

      // Update visible stats immediately so the runner never has to press sync to see totals.
      renderSessions();
      updateTopSummary();
      savedTotalKmEl.textContent = newTotalKm.toFixed(2);
      finishTotalEl.textContent = newTotalKm.toFixed(2);
      const immediatePct = Math.min((newTotalKm / TARGET_KM) * 100, 100);
      progressFillEl.style.width = immediatePct + "%";
      syncRunToVault();

      setStatus("Run saved — syncing to WRW Hub...", "status-saved");

      // Keep the map at the OLD progress while we jump back to it.
      updateRouteVisual(previousTotalKm);
      scrollToDeadmanMap();

      // Then update everything with the delayed map-fill animation so the runner sees it happen.
      window.setTimeout(() => {
        updateOverallProgress({ animateFromKm: previousTotalKm });
      }, 650);

      // Auto-sync immediately after every distance entry.
      try{
        await saveCloudProgress();
        addSyncDebug("auto sync after add", "finished; cloudReady=" + cloudReady);
        localStorage.setItem("wrw_hub_force_refresh", String(Date.now()));
      }catch(err){
        addSyncDebug("auto sync after add error", err && err.message ? err.message : err);
        setStatus("Saved on this device. Auto sync failed — try again when connected.", "status-saved");
      }
    }

