    const text = document.getElementById("deadmanAccountStatusText");
    const note = document.getElementById("deadmanAccountStatusNote");
    const card = document.getElementById("deadmanAccountStatusCard");
    const sync = document.getElementById("deadmanManualSyncStatus");

    if(card){
      card.classList.remove("ready","warning");
      if(state) card.classList.add(state);
    }

    if(text && message) text.textContent = message;

    if(note){
      if(state === "ready") note.textContent = "Deadman is linked to your WRW account. Progress can sync to the Hub.";
      if(state === "warning") note.textContent = "Open this app from the WRW Hub so your progress can sync.";
    }

    if(sync && message) sync.textContent = message;
  }

  function getClient(){
    if(sbDeadman) return sbDeadman;
    if(!window.supabase || !SUPABASE_URL || !SUPABASE_ANON_KEY) return null;

    sbDeadman = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
      auth: {
        persistSession:false,
        autoRefreshToken:false,
        detectSessionInUrl:false
      },
      global: {
        headers: getToken() ? { Authorization: "Bearer " + getToken() } : {}
      }
    });

    return sbDeadman;
  }

  async function upsertProgress(raceId, distanceDone){
    const client = getClient();
    const userId = getUserId();

    if(!client) throw new Error("Supabase client missing");
    if(!userId || !getToken()) throw new Error("Missing Hub login token");

    // Same table pattern as Warrior/Rattlesnake. Do NOT send updated_at in case the table doesn't have it.
    const result = await client
      .from("user_progress")
      .upsert({
        user_id: userId,
        race_id: raceId,
        distance_done: Number(distanceDone) || 0
      }, {
        onConflict: "user_id,race_id"
      })
      .select();

    if(result.error) throw result.error;
    return result.data;
  }

  async function loadProgress(raceId){
    const client = getClient();
    const userId = getUserId();

    if(!client) throw new Error("Supabase client missing");
    if(!userId || !getToken()) throw new Error("Missing Hub login token");

    const result = await client
      .from("user_progress")
      .select("distance_done")
      .eq("user_id", userId)
      .eq("race_id", raceId)
      .maybeSingle();

    if(result.error) throw result.error;
    return result.data && result.data.distance_done !== null ? Number(result.data.distance_done) : 0;
  }

  async function saveDeadmanCloudProgress(){
    if(syncBusy) return;
    syncBusy = true;

    try{
      if(!getUserId() || !getToken()){
        updateStatus("Not linked to WRW Hub. Open Deadman from the Hub.", "warning");
        return;
      }

      updateStatus("Syncing Deadman progress...", "ready");

      await upsertProgress(DEADMAN_MAIN_RACE_ID, getMainKm());
      await upsertProgress(DEADMAN_FINAL_RACE_ID, getFinalKm());

      updateStatus("Synced with WRW Hub.", "ready");
    }catch(e){
      console.error("Deadman sync failed:", e);
      const msg = e && e.message ? e.message : "Unknown error";
      updateStatus("Sync failed: " + msg, "warning");
    }finally{
      syncBusy = false;
    }
  }

  async function loadDeadmanCloudProgress(){
    if(initialCloudLoadDone) return;
    initialCloudLoadDone = true;

    try{
      if(!getUserId() || !getToken()){
        updateStatus("Not linked to your WRW account.", "warning");
        return;
      }

      updateStatus("Loading Deadman cloud progress...", "ready");

      const cloudMain = await loadProgress(DEADMAN_MAIN_RACE_ID);
      const cloudFinal = await loadProgress(DEADMAN_FINAL_RACE_ID);

      setMainKm(Math.max(getMainKm(), cloudMain));
      setFinalKm(Math.max(getFinalKm(), cloudFinal));

      if(typeof window.deadmanUpdate21KVisuals === "function") window.deadmanUpdate21KVisuals();
      if(typeof window.deadmanRenderSavedRuns === "function") window.deadmanRenderSavedRuns();
      if(typeof window.deadmanUpdateCards === "function") window.deadmanUpdateCards();
      if(typeof window.deadmanCheckCompletionPopup === "function") window.deadmanCheckCompletionPopup();

      updateStatus("Linked and ready to sync.", "ready");
    }catch(e){
      console.error("Deadman cloud load failed:", e);
      const msg = e && e.message ? e.message : "Unknown error";
      updateStatus("Cloud load failed: " + msg, "warning");
    }
  }

  window.saveCloudProgress = saveDeadmanCloudProgress;
  window.deadmanManualSyncToHub = saveDeadmanCloudProgress;
  window.deadmanLoadCloudProgress = loadDeadmanCloudProgress;

  function wrapFunction(name){
    const original = window[name];
    if(typeof original !== "function" || original.__deadmanSyncWrapped) return;

    const wrapped = function(){
      const result = original.apply(this, arguments);
      setTimeout(saveDeadmanCloudProgress, 300);
      return result;
    };

    wrapped.__deadmanSyncWrapped = true;
    window[name] = wrapped;
  }

  function installAutoSyncHooks(){
    [
      "deadmanAddMain",
      "deadmanAddMainManual",
      "addDeadmanFinalDistance",
      "deadmanDeleteRun",
      "deadmanDeleteAllRuns",
      "deadmanForceVisualReset"
    ].forEach(wrapFunction);
  }

  window.addEventListener("load", function(){
    document.querySelectorAll('a[href*="TESTING-HUB"]').forEach(function(a){ a.href = DEADMAN_HUB_URL; });
    installAutoSyncHooks();
    setTimeout(loadDeadmanCloudProgress, 500);
    setTimeout(installAutoSyncHooks, 1000);
  });

  setInterval(installAutoSyncHooks, 1500);
})();
</script>

