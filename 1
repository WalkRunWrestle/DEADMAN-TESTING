    async function connectSupabaseInBackground(){
      try {
        setStatus("Opening Deadman. Checking WRW Hub account in the background...", "status-saved");

        const linkedUser = await getLinkedUserFromSupabase();

        if (!linkedUser) {
          cloudReady = false;
          setStatus("Deadman is open. No Hub login was found yet — log in through the Hub for cloud sync.", "status-ready");
          return;
        }

        wrwUserId = linkedUser.id;
        wrwUserEmail = linkedUser.email;
        cloudReady = true;

        setStatus("Connected to WRW Hub" + (wrwUserEmail ? " · " + wrwUserEmail : "") + ". Syncing progress...", "status-saved");

        try {
          await withTimeout(syncInitialCloudProgress(), 6000);
          renderSessions();
          renderCollectables();
          updateOverallProgress();
          updateCollectablesHeader();
          setStatus("Connected to WRW Hub" + (wrwUserEmail ? " · " + wrwUserEmail : ""), "status-ready");
        } catch (syncErr) {
          console.log("Initial cloud sync skipped:", syncErr);
          setStatus("Connected to WRW Hub. You can log progress — it will sync when saved.", "status-ready");
        }
      } catch (err) {
        console.log("Background account check failed:", err);
        cloudReady = false;
        setStatus("Deadman is open. Cloud sync could not connect yet — progress is saved on this device.", "status-ready");
      }
    }

