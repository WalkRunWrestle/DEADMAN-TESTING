.flame-a{left:31%;top:72%;}.flame-b{right:31%;top:72%;}
.flame-c{left:33%;top:56%;}.flame-d{right:33%;top:56%;}
.flame-e{left:36%;top:39%;}.flame-f{right:36%;top:39%;}
