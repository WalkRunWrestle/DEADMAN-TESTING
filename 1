    function checkCollectableUnlocks(totalKm){
      const state = getCollectableState();
      let newlyUnlocked = null;

      for (const card of COLLECTABLE_DEFS){
        if (totalKm >= card.km && !state[card.id]){
          state[card.id] = true;
          if (!newlyUnlocked) newlyUnlocked = card;
        }
      }

      saveCollectableState(state);
      renderCollectables();

      if (newlyUnlocked){
        showCollectableUnlock(newlyUnlocked);
      }
    }

    function updateTopSummary(){
      const sessions = getSessions();
      runsSavedCount.textContent = `${sessions.length} ${sessions.length === 1 ? "run" : "runs"}`;

      if (!sessions.length){
        lastSavedRun.textContent = "No runs saved yet";
        return;
      }

      const last = sessions[sessions.length - 1];
      const dateText = new Date(last.date).toLocaleDateString();
      lastSavedRun.textContent = `${last.distanceKm.toFixed(2)} km · ${dateText}`;
    }

    function updateRouteVisual(totalKm){
      const pct = Math.max(0, Math.min(totalKm / TARGET_KM, 1));
      const pathLength = routeFillPath.getTotalLength();
      routeFillPath.style.strokeDasharray = pathLength;
      routeFillPath.style.strokeDashoffset = pathLength * (1 - pct);

      const haloPath = document.getElementById("routeFillHalo");
      if (haloPath){
        haloPath.style.strokeDasharray = pathLength;
        haloPath.style.strokeDashoffset = pathLength * (1 - pct);
      }

      const snakeMarker = document.getElementById("snakeMarker");
      if (snakeMarker){
        const point = routeFillPath.getPointAtLength(pathLength * pct);
        snakeMarker.setAttribute("transform", `translate(${point.x} ${point.y})`);
      }

      routePercentEl.textContent = `${Math.round(pct * 100)}%`;

      const stage = pct >= 1 ? "Final Rattle"
        : pct >= .75 ? "Dust Ridge"
        : pct >= .50 ? "Main Street"
        : pct >= .25 ? "Saloon Mile"
        : "Town Gate";
      routeStageEl.textContent = stage;

      const caption = document.getElementById("routeCaption");
      if (caption){
        const remaining = Math.max(TARGET_KM - totalKm, 0).toFixed(2);
        caption.textContent = pct >= 1
          ? "Trail complete. The Final Rattle is beaten — send your proof and claim the finish."
          : `${remaining} km left through Deadman Town. Stay on the main road and unlock the next checkpoint.`;
      }

      document.getElementById("mile25").classList.toggle("done", pct >= .25);
      document.getElementById("mile50").classList.toggle("done", pct >= .50);
      document.getElementById("mile75").classList.toggle("done", pct >= .75);
      document.getElementById("mile100").classList.toggle("done", pct >= 1);

      const locations = [
        [document.getElementById("startNode"), pct < .25, true],
        [document.getElementById("dot25"), pct >= .25 && pct < .50, pct >= .25],
        [document.getElementById("dot50"), pct >= .50 && pct < .75, pct >= .50],
        [document.getElementById("dot75"), pct >= .75 && pct < 1, pct >= .75],
        [document.getElementById("dot100"), pct >= 1, pct >= 1]
      ];

      locations.forEach(([node, current, done]) => {
        if (!node) return;
        node.classList.toggle("current", !!current);
        node.classList.toggle("done", !!done);
        const lockText = node.querySelector(".node-lock");
        if (lockText && node.id !== "startNode") {
          const names = { dot25:"RS25 unlocked", dot50:"RS50 unlocked", dot75:"RS75 unlocked", dot100:"Medal claim unlocked" };
          const locked = { dot25:"RS25 locked", dot50:"RS50 locked", dot75:"RS75 locked", dot100:"Medal claim locked" };
          lockText.textContent = done ? names[node.id] : locked[node.id];
        }
      });

    }

    function updateFinishMessage(){
      finishMessage.innerHTML = `
        Attach your fitness app screenshot(s) to your email.<br><br>
        Make sure your distance is clearly visible.
      `;
    }

    function updateOverallProgress(options = {}){
      const totalKm = getTotalKm();
      const animateFromKm = typeof options.animateFromKm === "number" ? options.animateFromKm : null;
      const shouldAnimateRoute = animateFromKm !== null && animateFromKm !== totalKm;

      savedTotalKmEl.textContent = totalKm.toFixed(2);

      const pct = Math.min((totalKm / TARGET_KM) * 100, 100);
      progressFillEl.style.width = pct + "%";

      if (shouldAnimateRoute){
        playMapFillAnimation(animateFromKm, totalKm);
      } else {
        updateRouteVisual(totalKm);
      }

      finishTotalEl.textContent = totalKm.toFixed(2);
      updateFinishMessage();
      updateTopSummary();

      const unlockAndFinish = () => {
        checkCollectableUnlocks(totalKm);

        if (totalKm >= TARGET_KM){
          completionActions.style.display = "flex";
          setStatus("10K complete", "status-complete");

          const alreadyComplete = localStorage.getItem(COMPLETE_KEY) === "true";
          if (!alreadyComplete){
            localStorage.setItem(COMPLETE_KEY, "true");
            showFinishPopup();
          }
        } else {
          completionActions.style.display = "none";
          setStatus("Ready to log progress", "status-ready");
        }
      };

      if (shouldAnimateRoute){
        setTimeout(unlockAndFinish, 2800);
      } else {
        unlockAndFinish();
      }
    }

    function renderSessions(){
      const sessions = getSessions();

      if (!sessions.length){
        sessionListEl.innerHTML = `
          <div class="session-item">
            <div class="session-meta">No runs saved yet.</div>
          </div>
        `;
        return;
      }

      const reversed = sessions.slice().reverse();

      sessionListEl.innerHTML = reversed.map((session, reversedIndex) => `
        <div class="session-item">
          <div class="session-top">
            <span>Run ${sessions.length - reversedIndex}</span>
            <span>${session.distanceKm.toFixed(2)} km</span>
          </div>

          <div class="session-badge badge-log">Logged run</div>

          <div class="session-meta">
            Date: ${new Date(session.date).toLocaleDateString()}
          </div>
        </div>
      `).join("");

      updateCollectablesHeader();
    }

