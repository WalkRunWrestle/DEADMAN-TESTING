  flex-wrap:wrap;
  gap:8px;
}
.deadman-secret-badge{
  padding:9px 10px;
  border-radius:999px;
  border:1px solid rgba(216,209,220,.16);
  background:linear-gradient(180deg,#151020,#060409);
  color:#a99eb4;
  font-size:.72rem;
  font-weight:1000;
  letter-spacing:.06em;
}
.deadman-secret-badge.found{
  color:#f0e8f6;
  border-color:rgba(165,107,255,.44);
  background:linear-gradient(135deg,#251337,#8b3cff,#12091d);
  box-shadow:0 0 18px rgba(139,60,255,.24);
}
.deadman-secret-unlock{
  position:fixed;
  inset:0;
  z-index:100004;
  display:none;
  align-items:center;
  justify-content:center;
  padding:18px;
  background:rgba(0,0,0,.9);
}
.deadman-secret-unlock.show{display:flex;}
.deadman-secret-box{
  width:min(92vw,420px);
  min-height:260px;
  border-radius:24px;
  border:1px solid rgba(216,209,220,.16);
  background:#000;
  color:#f0e8f6;
  text-align:center;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  box-shadow:0 0 34px rgba(139,60,255,.28);
  padding:20px;
}
.deadman-secret-kicker{
  color:#a56bff;
  font-size:.75rem;
  font-weight:1000;
  letter-spacing:.22em;
  margin-bottom:12px;
}
.deadman-secret-name{
  font-size:1.75rem;
  font-weight:1000;
  line-height:1;
  text-shadow:0 0 18px rgba(139,60,255,.62);
}
.deadman-secret-box button{
  margin-top:18px;
  min-height:46px;
  min-width:160px;
  border-radius:16px;
  background:linear-gradient(135deg,#251337,#8b3cff,#12091d) !important;
  color:#f0e8f6 !important;
  font-weight:1000;
}
.deadman-vault-card.secret-card{display:none;}
.deadman-vault-card.secret-card.revealed{display:block;}
.deadman-awakened-mode{
  background:
    radial-gradient(circle at 20% 30%,rgba(139,60,255,.08),transparent 28%),
    radial-gradient(circle at 80% 70%,rgba(194,77,255,.08),transparent 34%),
    linear-gradient(180deg,#05010a,#000) !important;
}
.deadman-awakened-mode .deadman-clean::before{
  opacity:.22 !important;
  animation-duration:2s !important;
}
.deadman-awakened-mode .deadman-clean-hero h1{
  text-shadow:
    0 0 18px rgba(139,60,255,.92),
    0 0 38px rgba(139,60,255,.42);
}
.deadman-all-secrets-overlay{
  position:fixed;
  inset:0;
  z-index:100006;
  display:none;
  align-items:center;
  justify-content:center;
  padding:18px;
  background:rgba(0,0,0,.94);
}
.deadman-all-secrets-overlay.show{display:flex;}
.deadman-all-secrets-box{
  width:min(92vw,460px);
  border-radius:26px;
  border:1px solid rgba(216,209,220,.18);
  background:
    radial-gradient(circle at 50% 0%,rgba(139,60,255,.28),transparent 55%),
    #000;
  color:#f0e8f6;
  text-align:center;
  padding:24px;
  box-shadow:0 0 48px rgba(139,60,255,.35);
}
.deadman-all-secrets-kicker{
  color:#a56bff;
  font-size:.72rem;
  font-weight:1000;
  letter-spacing:.24em;
  margin-bottom:14px;
}
.deadman-all-secrets-title{
  font-size:2rem;
  line-height:.95;
  font-weight:1000;
  text-shadow:0 0 20px rgba(139,60,255,.72);
}
.deadman-all-secrets-sub{
  margin-top:10px;
  color:#a56bff;
  font-size:1rem;
  font-weight:1000;
  letter-spacing:.08em;
}
.deadman-all-secrets-rewards{
  margin-top:18px;
  display:grid;
  gap:8px;
}
.deadman-all-secrets-rewards div{
  padding:10px;
  border-radius:14px;
  border:1px solid rgba(216,209,220,.14);
  background:linear-gradient(180deg,#151020,#060409);
}
.deadman-sticker-reward{
  margin-top:18px;
  padding:14px;
  border-radius:18px;
  border:1px solid rgba(165,107,255,.28);
  background:rgba(139,60,255,.08);
  color:#d8d1dc;
  line-height:1.45;
  font-size:.86rem;
}
.deadman-all-secrets-box button{
  margin-top:18px;
  min-height:50px;
  width:100%;
  border-radius:16px;
  background:linear-gradient(135deg,#251337,#8b3cff,#12091d) !important;
  color:#f0e8f6 !important;
  font-weight:1000;
  letter-spacing:.08em;
}
.deadman-storm-mode{animation:deadmanStormShake .35s ease 3;}
@keyframes deadmanStormShake{
  0%,100%{filter:brightness(1);}
  40%{filter:brightness(1.7) hue-rotate(22deg);}
}

