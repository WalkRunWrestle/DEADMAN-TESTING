  position:relative;
  z-index:2;
  height:100%;
  min-height:170px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:6px;
}
.deadman-card-lock{
  font-size:2.1rem;
  line-height:1;
  color:#3d3348;
}
