  min-height:170px;
  padding:0;
  border-radius:18px;
  overflow:hidden;
  border:1px solid rgba(216,209,220,.16);
  background:#000 !important;
  color:#f0e8f6;
  box-shadow:0 14px 30px rgba(0,0,0,.48),0 0 18px rgba(139,60,255,.12);
}
.deadman-vault-card::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    radial-gradient(circle at 50% 34%,rgba(139,60,255,.22),transparent 35%),
    linear-gradient(180deg,#050407,#000);
  opacity:.9;
}
.deadman-vault-card.unlocked::before{
  background:
    radial-gradient(circle at 50% 30%,rgba(139,60,255,.48),transparent 38%),
    linear-gradient(180deg,#140c1f,#000);
}
