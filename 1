<script>
(function(){
  const savedKey = "wrw_deadman_saved_runs_v1";
  const mainKey = "wrw_deadman_main_21k_progress_v2";
  const finalKey = "wrw_deadman_final_1k_progress_v2";

  function getSavedRuns(){
    try{
      const raw = localStorage.getItem(savedKey);
      const runs = raw ? JSON.parse(raw) : [];
      return Array.isArray(runs) ? runs : [];
    }catch(e){
      return [];
    }
  }

  function setSavedRuns(runs){
    localStorage.setItem(savedKey, JSON.stringify(runs || []));
  }

  function formatDate(value){
    if(!value) return "";
    try{
      const d = new Date(value);
      if(!isNaN(d.getTime())){
        return d.toLocaleDateString("en-GB");
      }
    }catch(e){}
    return String(value);
  }

  function requireWRWPassword(actionText){
    const pass = prompt((actionText || "Delete") + "\n\nType WRW to confirm.");
    return pass && pass.trim().toUpperCase() === "WRW";
  }

  window.deadmanRenderSavedRuns = function(){
    const list = document.getElementById("deadmanSavedRunsList");
    if(!list) return;

    const runs = getSavedRuns();
    if(!runs.length){
      list.innerHTML = '<div class="deadman-empty-runs">No runs saved yet.</div>';
      return;
    }

    list.innerHTML = runs.slice().reverse().map(function(run, reverseIndex){
      const index = runs.length - 1 - reverseIndex;
      const km = Number(run.km || run.distance || 0) || 0;
      const date = formatDate(run.date || run.createdAt || run.created_at || Date.now());
      const type = run.type === "final" ? "Final 1K" : "Streak";
      return `
        <div class="deadman-run-row">
          <div class="deadman-run-main">
            <div class="deadman-run-title">${type} · ${km.toFixed(2)} km</div>
            <div class="deadman-run-meta">Saved run ${index + 1}${date ? " · " + date : ""}</div>
          </div>
          <button class="deadman-run-delete" type="button" onclick="deadmanDeleteRun(${index})">DELETE</button>
        </div>
      `;
    }).join("");
  };

  window.deadmanSaveRunEntry = function(km, type){
    km = Number(km) || 0;
    if(km <= 0) return;
    const runs = getSavedRuns();
    runs.push({
      km: km,
      type: type || "streak",
      date: new Date().toISOString()
    });
    setSavedRuns(runs);
    deadmanRenderSavedRuns();
  };


  window.deadmanForceVisualReset = function(){
    try{
      localStorage.setItem("wrw_deadman_main_21k_progress_v2", "0");
      localStorage.setItem("wrw_deadman_final_1k_progress_v2", "0");
      localStorage.removeItem("wrw_deadman_finish_popup_seen_v1");
      localStorage.setItem("wrw_deadman_was_complete_v2","no");
      localStorage.setItem("wrw_deadman_final_unlocked_seen_v1","no");
      localStorage.removeItem("wrw_deadman_unlocked_cards_v1");
      localStorage.removeItem("wrw_deadman_seen_card_popups_v1");
    }catch(e){}

    const route = document.getElementById("deadmanCleanRouteLive");
    if(route){
      route.style.strokeDasharray = "1000";
      route.style.strokeDashoffset = "1000";
    }

    const orb = document.getElementById("deadmanCleanOrb");
    if(orb) orb.style.bottom = "10%";

    document.querySelectorAll(".deadman-cp").forEach(function(cp){
      const need = Number(cp.getAttribute("data-km")) || 0;
      cp.classList.toggle("done", need === 0);
    });

    document.querySelectorAll(".deadman-flame").forEach(function(flame){
      flame.classList.remove("lit");
    });

    const mainStatus = document.getElementById("deadmanMainStatus");
    if(mainStatus) mainStatus.textContent = "0.00 / 21 KM";

    const finalText = document.getElementById("deadmanFinalProgressText");
    if(finalText) finalText.textContent = "0.00 / 1 KM";

    const finalFill = document.getElementById("deadmanFinalFill");
    if(finalFill) finalFill.style.width = "0%";

    const finalTab = document.getElementById("deadmanCleanFinalTab");
    if(finalTab){
      finalTab.classList.add("locked");
      finalTab.classList.remove("unlocked");
    }

    const finalPanel = document.getElementById("deadmanCleanFinal");
    if(finalPanel) finalPanel.classList.remove("open");

    const finalState = document.getElementById("deadmanCleanFinalState");
    if(finalState) finalState.textContent = "LOCKED";
  };


  window.deadmanRecalculateTotalsFromSavedRuns = function(){
    const runs = getSavedRuns();
    let mainTotal = 0;
    let finalTotal = 0;
    runs.forEach(function(run){
      const km = Number(run.km || run.distance || 0) || 0;
      if(run.type === "final") finalTotal += km;
      else mainTotal += km;
    });
    mainTotal = Math.max(0, Math.min(21, mainTotal));
    finalTotal = Math.max(0, Math.min(1, finalTotal));
    localStorage.setItem(mainKey, String(mainTotal));
    localStorage.setItem(finalKey, String(finalTotal));
  };

  window.deadmanDeleteRun = function(index){
    const runs = getSavedRuns();
    if(index < 0 || index >= runs.length) return;
    if(!requireWRWPassword("Delete this saved run?")) return;

    const removed = runs.splice(index, 1)[0];
