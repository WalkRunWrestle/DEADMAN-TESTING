<script>
(function(){
  const mainKey = "wrw_deadman_main_21k_progress_v2";
  const finalKey = "wrw_deadman_final_1k_progress_v2";

  window.deadmanTogglePanel = function(id){
    const el = document.getElementById(id);
    if(el) el.classList.toggle("open");
  };

  function getOriginalTotal(){
    return 0;
  }

  function getMain(){
    return Math.max(0, Math.min(21, Number(localStorage.getItem(mainKey)) || 0));
  }
  window.deadmanGetMainForEmail = getMain;

  function setMain(km){
    km = Math.max(0, Math.min(21, Number(km) || 0));
    localStorage.setItem(mainKey, String(km));
    updateDeadmanClean();
  }

  window.deadmanAddMain = function(km){
    const hiddenInput = document.getElementById("manualDistance");
    const hiddenBtn = document.getElementById("manualAddBtn");
    if(hiddenInput && hiddenBtn){
      hiddenInput.value = String(km);
      hiddenBtn.click();
      setTimeout(function(){
        setMain(getOriginalTotal());
      }, 250);
    } else {
      setMain(getMain() + Number(km || 0));
    }
  };

  window.deadmanAddMainManual = function(){
    const input = document.getElementById("deadmanMainManual");
    const add = Number(input && input.value ? input.value : 0);
    if(!add || add <= 0){
      alert("Add a distance first.");
      return;
    }
    window.deadmanAddMain(add);
    if(input) input.value = "";
  };

  function getFinal(){
    return Math.max(0, Math.min(1, Number(localStorage.getItem(finalKey)) || 0));
  }
  window.deadmanGetFinalForEmail = getFinal;

  function setFinal(km){
    localStorage.setItem(finalKey, String(Math.max(0, Math.min(1, Number(km) || 0))));
  }

  window.deadmanOpenFinal = function(){
    if(getMain() < 21){
      alert("Complete the 21K Streak path first.");
      return;
    }
    window.deadmanTogglePanel("deadmanCleanFinal");
  };

  window.addDeadmanFinalDistance = function(){
    if(getMain() < 21){
      alert("Complete the 21K Streak path first.");
      return;
    }
    const input = document.getElementById("deadmanFinalKmInput");
    const add = Number(input && input.value ? input.value : 0);
    if(!add || add <= 0){
      alert("Add a final 1K distance first.");
      return;
    }
    setFinal(getFinal() + add);
    if(input) input.value = "";
    updateDeadmanClean();
    if(typeof deadmanBuildProofEmail === "function") deadmanBuildProofEmail();
  };

  function updateDeadmanClean(){
    const km = getMain();
    const pct = Math.max(0, Math.min(km / 21, 1));
    const orb = document.getElementById("deadmanCleanOrb");
    const route = document.getElementById("deadmanCleanRouteLive");
    const status = document.getElementById("deadmanMainStatus");
    if(orb) orb.style.bottom = (10 + (72 * pct)) + "%";
    if(route){
      const len = 1000;
      route.style.strokeDasharray = len;
      route.style.strokeDashoffset = len - (len * pct);
    }
    if(status) status.textContent = km.toFixed(2) + " / 21 KM";

    document.querySelectorAll(".deadman-cp").forEach(function(cp){
      const need = Number(cp.getAttribute("data-km")) || 0;
      cp.classList.toggle("done", km >= need);
    });
    document.querySelectorAll(".deadman-flame").forEach(function(flame){
      const need = Number(flame.getAttribute("data-km")) || 999;
      flame.classList.toggle("lit", km >= need);
    });

    const complete = km >= 21;
    const finalTab = document.getElementById("deadmanCleanFinalTab");
    const finalState = document.getElementById("deadmanCleanFinalState");
    if(finalTab){
      finalTab.classList.toggle("locked", !complete);
      finalTab.classList.toggle("unlocked", complete);
    }
    if(finalState) finalState.textContent = complete ? "UNLOCKED" : "LOCKED";

    const finalKm = getFinal();
    const finalText = document.getElementById("deadmanFinalProgressText");
    const finalFill = document.getElementById("deadmanFinalFill");
    const finalNote = document.getElementById("deadmanFinalNote");
    if(finalText) finalText.textContent = finalKm.toFixed(2) + " / 1 KM";
    if(finalFill) finalFill.style.width = Math.min(finalKm * 100, 100) + "%";
    if(finalNote) finalNote.textContent = finalKm >= 1 ? "Final 1K complete." : "Manual add only for the final 1K.";
  }

  // Fix access button state: accept RS001 or DM001 and don't get stuck disabled.
  function patchAccessGate(){
    const input = document.getElementById("entryCodeInput");
    const btn = document.getElementById("startAppBtn");
    const err = document.getElementById("entryCodeError");
    const status = document.getElementById("loginStatus");
    if(!input || !btn) return;

    function ok(){
      const v = input.value.trim().toUpperCase();
      return v === "RS001" || v === "DM001";
    }

    btn.disabled = false;
    btn.textContent = "Open Deadman";

    btn.addEventListener("click", function(e){
      if(!ok()){
        if(err){
          err.textContent = "Wrong code. Please enter RS001.";
          err.classList.add("show");
        }
        if(status) status.textContent = "Enter the correct Deadman code to continue.";
        e.stopImmediatePropagation();
        e.preventDefault();
        return false;
      }
    }, true);

    input.addEventListener("input", function(){
      input.value = input.value.toUpperCase();
      btn.disabled = false;
      btn.textContent = "Open Deadman";
      if(err) err.classList.remove("show");
    });
  }

  window.addEventListener("load", function(){
    patchAccessGate();
    updateDeadmanClean();
  });
  setInterval(updateDeadmanClean, 800);
})();
</script>


