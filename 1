    if(popup) popup.classList.remove("show");
    if(currentCardToReveal){
      deadmanViewCard(currentCardToReveal);
    }
  };

  window.deadmanViewCard = function(card){
    const viewer = document.getElementById("deadmanCardViewer");
    const img = document.getElementById("deadmanCardViewerImg");
    if(img) img.src = card;
    if(viewer) viewer.classList.add("show");
  };

  window.deadmanCloseCardViewer = function(){
    const viewer = document.getElementById("deadmanCardViewer");
    if(viewer) viewer.classList.remove("show");
  };

  window.deadmanOpenCard = function(btn){
    const card = btn.getAttribute("data-card");
    if(!card) return;
    if(btn.classList.contains("locked")){
      alert("This card has not unlocked yet.");
      return;
    }
    deadmanViewCard(card);
  };

  window.deadmanUpdateCards = function(){
    const km = getMainKmForCards();
    let unlocked = readList(cardUnlockKey);
    let seen = readList(cardSeenKey);
    let newlyUnlocked = null;

    document.querySelectorAll(".deadman-vault-card").forEach(function(btn){
      const need = Number(btn.getAttribute("data-km")) || 999;
      const card = btn.getAttribute("data-card");
      const isUnlocked = km >= need;

      if(isUnlocked && card && unlocked.indexOf(card) === -1){
        unlocked.push(card);
        if(seen.indexOf(card) === -1 && !newlyUnlocked){
          newlyUnlocked = card;
          seen.push(card);
        }
      }

      const storedUnlocked = card && unlocked.indexOf(card) > -1;
      btn.classList.toggle("unlocked", storedUnlocked);
      btn.classList.toggle("locked", !storedUnlocked);
    });

    writeList(cardUnlockKey, unlocked);
    writeList(cardSeenKey, seen);

    const count = document.getElementById("deadmanVaultCount");
    if(count) count.textContent = unlocked.length + " / 4";

    if(newlyUnlocked){
      showCardPopup(newlyUnlocked);
    }
  };

  window.addEventListener("load", function(){
    deadmanUpdateCards();
  });

  setInterval(function(){
    deadmanUpdateCards();
  }, 900);
})();
</script>


