/* vault upgrade: tombstone / pedestals */
.deadman-vault-card{
  clip-path:polygon(0 18%,50% 0,100% 18%,100% 100%,0 100%);
}
.deadman-vault-card.unlocked{
  transform:translateY(-2px);
