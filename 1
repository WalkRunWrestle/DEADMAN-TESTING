        oldFinal();
        if(add > 0) deadmanSaveRunEntry(add, "final");
      };
    }
  }

  window.addEventListener("load", function(){
    hookSaveFunctions();
    deadmanRenderSavedRuns();
  });
  setTimeout(function(){
    hookSaveFunctions();
    deadmanRenderSavedRuns();
  }, 500);
})();
</script>


<script>
(function(){
  const cardUnlockKey = "wrw_deadman_unlocked_cards_v1";
  const cardSeenKey = "wrw_deadman_seen_card_popups_v1";
  let currentCardToReveal = null;

  function readList(key){
    try{
      const raw = localStorage.getItem(key);
      const list = raw ? JSON.parse(raw) : [];
      return Array.isArray(list) ? list : [];
    }catch(e){ return []; }
  }

  function writeList(key, list){
    localStorage.setItem(key, JSON.stringify(Array.from(new Set(list || []))));
  }

  function getMainKmForCards(){
    try{
      if(typeof window.deadmanGetMainForEmail === "function"){
        return Number(window.deadmanGetMainForEmail()) || 0;
      }
    }catch(e){}
    try{
      return Number(localStorage.getItem("wrw_deadman_main_21k_progress_v2")) || 0;
    }catch(e){}
    return 0;
  }

  function showCardPopup(card){
    currentCardToReveal = card;
