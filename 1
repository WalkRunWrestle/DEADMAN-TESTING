/* ===== DEADMAN EPIC EXPERIENCE LAYER ===== */
.deadman-clean{
  position:relative;
}
.deadman-clean::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:1;
  background:
    repeating-linear-gradient(180deg,rgba(255,255,255,.035) 0 1px,transparent 1px 5px),
    radial-gradient(circle at 50% 20%,transparent 0 45%,rgba(0,0,0,.22) 78%);
  mix-blend-mode:screen;
  opacity:.18;
  animation:deadmanCrt 4s infinite alternate;
}
@keyframes deadmanCrt{
  from{opacity:.13;filter:hue-rotate(0deg);}
  to{opacity:.22;filter:hue-rotate(10deg);}
}

.deadman-intro{
  position:fixed;
  inset:0;
  z-index:100002;
  background:#000;
  display:flex;
  align-items:center;
  justify-content:center;
  pointer-events:none;
  animation:deadmanIntroOut 4.8s ease forwards;
}
.deadman-intro-smoke{
  position:absolute;
  inset:-20%;
  background:
    radial-gradient(circle at 20% 40%,rgba(139,60,255,.18),transparent 30%),
    radial-gradient(circle at 80% 55%,rgba(194,77,255,.14),transparent 34%),
    radial-gradient(circle at 50% 70%,rgba(255,255,255,.06),transparent 30%);
  filter:blur(20px);
  animation:deadmanSmoke 5s ease-in-out infinite alternate;
}
.deadman-intro-text{
  position:relative;
  z-index:2;
  text-align:center;
  color:#f0e8f6;
}
.deadman-intro-text span{
  display:block;
  color:#a56bff;
  font-size:.78rem;
  font-weight:1000;
  letter-spacing:.28em;
  margin-bottom:12px;
}
.deadman-intro-text strong{
  display:block;
  font-size:2.45rem;
  line-height:.95;
  letter-spacing:.04em;
  text-shadow:0 0 20px rgba(139,60,255,.7),0 0 42px rgba(139,60,255,.3);
}
@keyframes deadmanIntroOut{
  0%,72%{opacity:1;visibility:visible;}
  100%{opacity:0;visibility:hidden;}
}
@keyframes deadmanSmoke{
  from{transform:translateX(-18px) scale(1.02);}
  to{transform:translateX(18px) scale(1.08);}
}

/* moving fog over maps */
.deadman-map-frame::after{
  content:"";
  position:absolute;
  inset:-15%;
  background:
    radial-gradient(180px 80px at 20% 70%,rgba(216,209,220,.10),transparent 70%),
    radial-gradient(220px 90px at 75% 55%,rgba(139,60,255,.10),transparent 72%),
    radial-gradient(180px 70px at 45% 35%,rgba(255,255,255,.06),transparent 70%);
  filter:blur(12px);
  opacity:.55;
  z-index:5;
  pointer-events:none;
  animation:deadmanMapFog 8s ease-in-out infinite alternate;
}
@keyframes deadmanMapFog{
  from{transform:translateX(-20px);}
  to{transform:translateX(22px);}
}

/* footprints / ash trail */
.deadman-footprint{
  position:absolute;
  width:7px;
  height:12px;
  border-radius:999px;
  background:rgba(194,77,255,.65);
  box-shadow:0 0 12px rgba(139,60,255,.75);
  z-index:6;
  opacity:.72;
  pointer-events:none;
  transform:translate(-50%,-50%) rotate(14deg);
}
.deadman-ash{
  position:absolute;
  width:4px;
  height:4px;
  border-radius:999px;
  background:rgba(216,209,220,.8);
  box-shadow:0 0 10px rgba(139,60,255,.7);
  z-index:9;
  pointer-events:none;
  animation:deadAsh 1.6s ease forwards;
}
@keyframes deadAsh{
  to{transform:translateY(-42px) scale(.3);opacity:0;}
}

/* lightning unlock */
.deadman-lightning{
  position:fixed;
  inset:0;
  background:rgba(220,205,255,.72);
  z-index:100003;
  pointer-events:none;
  opacity:0;
}
.deadman-lightning.flash{
  animation:deadLightning .75s ease forwards;
}
@keyframes deadLightning{
  0%{opacity:0;}
  15%{opacity:.78;}
  22%{opacity:.1;}
  38%{opacity:.55;}
  100%{opacity:0;}
}

/* stats wall */
.deadman-stats-wall{
  margin-top:12px;
  padding:14px;
  border-radius:24px;
  border:1px solid rgba(216,209,220,.15);
  background:
    radial-gradient(300px 150px at 50% 0%,rgba(139,60,255,.15),transparent 70%),
    linear-gradient(180deg,#100a18,#040307);
  box-shadow:0 18px 44px rgba(0,0,0,.55), inset 0 0 28px rgba(139,60,255,.06);
}
.deadman-stats-kicker{
  color:#a56bff;
  font-size:.72rem;
  font-weight:1000;
  letter-spacing:.22em;
  margin-bottom:10px;
}
.deadman-stats-grid{
