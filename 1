<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Deadman</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#f6f7f9;
      --panel:#ffffff;
      --panel2:#f2f4f7;
      --border:#d9dee6;
      --text:#111418;
      --muted:rgba(17,20,24,.68);
      --green:#048d64;
      --green2:#06a879;
      --gold:#e6b84a;
      --danger:#a62d2d;
    }

    *{box-sizing:border-box}
    html,body{margin:0}
    body{
      font-family:Inter, Arial, sans-serif;
      color:var(--text);
      background:
        radial-gradient(900px 500px at 20% 10%, rgba(4,141,100,.10), transparent 60%),
        radial-gradient(700px 400px at 100% 0%, rgba(230,184,74,.10), transparent 55%),
        linear-gradient(180deg, #ffffff, #f3f5f7);
    }

    .screen{
      min-height:100vh;
      display:none;
      padding:10px 10px 18px;
      justify-content:center;
      align-items:center;
    }
    .screen.active{display:flex}

    .card{
      width:min(96vw, 760px);
      background:rgba(255,255,255,.92);
      border:1px solid var(--border);
      border-radius:16px;
      padding:10px;
      box-shadow:0 14px 30px rgba(16,24,40,.08);
      backdrop-filter: blur(4px);
    }

    .login-card{
      width:min(94vw, 380px);
      text-align:center;
      padding:14px;
    }

    .logo{
      display:block;
      max-width:120px;
      width:100%;
      height:auto;
      margin:0 auto 8px;
    }

    .medal{
      display:block;
      max-width:120px;
      width:100%;
      height:auto;
      margin:10px auto;
      border-radius:12px;
      border:1px solid var(--border);
      background:rgba(17,20,24,.03);
      padding:4px;
    }

    .medal-small{
      display:block;
      max-width:95px;
      width:100%;
      height:auto;
      margin:6px auto 10px;
      border-radius:12px;
      border:1px solid var(--border);
      background:rgba(17,20,24,.03);
      padding:4px;
    }

    h1,h2,h3,p{margin:0}

    .title{
      font-size:20px;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.4px;
      text-align:center;
    }

    .sub{
      margin-top:5px;
      color:var(--muted);
      font-size:12px;
      text-align:center;
      line-height:1.4;
    }

    .notice{
      margin-top:8px;
      padding:9px 10px;
      border-radius:12px;
      border:1px solid var(--border);
      background:rgba(17,20,24,.03);
      color:var(--muted);
      font-size:11px;
      line-height:1.45;
    }

    .pill-note{
      display:inline-block;
      margin-top:10px;
      padding:8px 12px;
      border-radius:999px;
      border:1px solid rgba(4,141,100,.25);
      background:rgba(4,141,100,.10);
      color:var(--green);
      font-size:11px;
      font-weight:800;
    }

    .input{
      width:100%;
      padding:11px 12px;
      border-radius:12px;
      border:1px solid var(--border);
      background:#ffffff;
      color:var(--text);
      font-size:14px;
      margin-top:10px;
      outline:none;
    }

    .btn{
      border:none;
      border-radius:12px;
      padding:11px 13px;
      font-size:14px;
      font-weight:900;
      cursor:pointer;
      transition:transform .15s ease, filter .15s ease, opacity .15s ease;
      text-decoration:none;
      text-align:center;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:8px;
    }

    .btn:hover{transform:translateY(-1px);filter:brightness(1.05)}
    .btn:disabled{opacity:.45;cursor:not-allowed;transform:none;filter:none}

    .btn-primary{
      background:linear-gradient(135deg,var(--green),var(--green2));
      color:#fff;
      box-shadow:0 10px 24px rgba(4,141,100,.16);
    }

    .btn-secondary{
      background:#ffffff;
      color:var(--text);
      border:1px solid var(--border);
    }

    .btn-danger{background:var(--danger);color:#fff}
    .btn-gold{
      background:linear-gradient(135deg, rgba(230,184,74,1), rgba(255,214,107,1), rgba(194,143,44,1));
      color:#141418;
    }

    .btn-certificate{
      background:linear-gradient(135deg, #19b77f, #33d69e);
      color:#ffffff;
      box-shadow:0 0 0 1px rgba(255,255,255,.30), 0 10px 24px rgba(25,183,127,.16);
    }

    .full{width:100%;margin-top:10px}

    .app-wrap{
      width:min(96vw, 940px);
      display:flex;
      flex-direction:column;
      gap:8px;
    }

    .top-card{
      text-align:center;
      padding:10px;
      background:
        radial-gradient(430px 200px at 50% 0%, rgba(4,141,100,.12), transparent 70%),
        linear-gradient(180deg, #ffffff, #f7f9fb);
    }

    .status-bar{
      margin-top:8px;
      padding:9px 10px;
      border-radius:12px;
      border:1px solid var(--border);
      background:rgba(17,20,24,.04);
      font-size:11px;
      font-weight:800;
      line-height:1.35;
    }
    .status-ready{ color:#0a7b58; }
    .status-saved{ color:#111418; }
    .status-complete{ color:#8d6330; }

    .progress-big{
      margin-top:6px;
      font-size:15px;
      font-weight:900;
      line-height:1.2;
    }

    .progress-bar{
      width:100%;
      height:10px;
      border-radius:999px;
      background:rgba(17,20,24,.08);
      border:1px solid var(--border);
      overflow:hidden;
      margin-top:8px;
    }

    .progress-fill{
      height:100%;
      width:0%;
      background:linear-gradient(90deg, #036c4b, #048d64, #0ab17e);
      transition:width .25s ease;
    }

    .summary-strip{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:6px;
      margin-top:8px;
    }

    .summary-box{
      border:1px solid var(--border);
      background:rgba(255,255,255,.03);
      border-radius:12px;
      padding:8px 9px;
      text-align:left;
    }

    .summary-label{
      font-size:9px;
      color:var(--muted);
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:.4px;
    }

    .summary-value{
      margin-top:3px;
      font-size:12px;
      font-weight:900;
      line-height:1.25;
    }

    .route-card{
      margin-top:10px;
      border:1px solid rgba(89,64,38,.34);
      border-radius:22px;
      overflow:hidden;
      background:
        radial-gradient(520px 260px at 50% 0%, rgba(255,236,189,.55), transparent 68%),
        linear-gradient(180deg, #fbf3df 0%, #ead2a6 58%, #d8b071 100%);
      text-align:left;
      box-shadow:0 18px 42px rgba(17,20,24,.12), inset 0 0 0 1px rgba(255,255,255,.70);
      position:relative;
    }

    .route-card::before{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      background:
        radial-gradient(circle at 12% 18%, rgba(65,43,22,.08) 0 1px, transparent 2px),
        radial-gradient(circle at 70% 64%, rgba(65,43,22,.06) 0 1px, transparent 2px),
        repeating-linear-gradient(135deg, rgba(65,43,22,.025) 0 2px, transparent 2px 12px);
      mix-blend-mode:multiply;
      opacity:.75;
    }

    .route-head{
      position:relative;
      z-index:2;
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:10px;
      padding:14px 14px 8px;
    }

    .route-title{
      font-size:17px;
      font-weight:900;
      text-transform:uppercase;
      letter-spacing:.45px;
      line-height:1.05;
      color:#261b10;
    }

    .route-subtitle{
      margin-top:4px;
      color:rgba(38,27,16,.68);
      font-size:11px;
      font-weight:800;
      line-height:1.3;
    }

    .route-stage{
      font-size:11px;
      color:#5f401f;
      font-weight:900;
      white-space:nowrap;
      text-align:right;
      text-transform:uppercase;
      letter-spacing:.35px;
    }

    .route-percent{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:72px;
      padding:8px 11px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.62);
      background:linear-gradient(135deg, rgba(255,255,255,.82), rgba(228,190,117,.44));
      color:#261b10;
      font-size:13px;
      font-weight:900;
      letter-spacing:.2px;
      box-shadow:0 8px 20px rgba(65,43,22,.10);
    }

    .route-wrap{
      position:relative;
      z-index:2;
      padding:0 10px 12px;
    }

    .map-shell{
      position:relative;
      height:430px;
      overflow:hidden;
      border-radius:20px;
      border:1px solid rgba(65,43,22,.24);
      background:
        radial-gradient(140px 90px at 84% 12%, rgba(255,255,255,.35), transparent 70%),
        linear-gradient(180deg, #f8e8bf 0%, #e6c58d 56%, #c99655 100%);
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.42), inset 0 -24px 44px rgba(65,43,22,.12);
    }

    .map-shell::before{
      content:"";
      position:absolute;
      inset:0;
      background:
        radial-gradient(circle at 18% 20%, rgba(65,43,22,.11) 0 2px, transparent 3px),
        radial-gradient(circle at 78% 42%, rgba(65,43,22,.08) 0 2px, transparent 3px),
        radial-gradient(circle at 28% 82%, rgba(65,43,22,.08) 0 2px, transparent 3px);
      pointer-events:none;
      opacity:.65;
      z-index:1;
    }

    .western-map{
      position:relative;
      z-index:2;
      display:block;
      width:100%;
      height:100%;
    }

    .route-caption{
      color:rgba(38,27,16,.76);
      font-size:11px;
      line-height:1.38;
      margin-top:8px;
      font-weight:700;
    }

    .town-building{
      opacity:.80;
      filter:drop-shadow(0 5px 6px rgba(65,43,22,.14));
    }

    .building-face{fill:rgba(255,247,226,.82);stroke:#5b3b20;stroke-width:2;}
    .building-roof{fill:#7a4426;stroke:#4b2e19;stroke-width:2;}
    .building-sign{fill:#2c2117;stroke:#e8c782;stroke-width:1.5;}
    .building-text{fill:#f8e6b8;font-size:10px;font-weight:900;letter-spacing:.7px;text-anchor:middle;}
    .town-detail{fill:none;stroke:rgba(65,43,22,.42);stroke-width:2;stroke-linecap:round;}

    .map-location{
      opacity:.72;
      transition:opacity .22s ease, filter .22s ease;
    }

    .map-location.done{
      opacity:1;
      filter:drop-shadow(0 0 10px rgba(230,184,74,.45));
    }

    .map-location.current{
      opacity:1;
      filter:drop-shadow(0 0 12px rgba(4,141,100,.24));
    }

    .node-ring{
      fill:#ede0c4;
      stroke:#5b3b20;
      stroke-width:3;
    }

    .map-location.done .node-ring{
      fill:#f7ddb0;
      stroke:#048d64;
      stroke-width:4;
    }

    .map-location.current .node-ring{
      fill:#fff9ec;
      stroke:#048d64;
      stroke-width:4;
    }

    .node-icon{font-size:14px;font-weight:900;fill:#2b2014;dominant-baseline:middle;text-anchor:middle;}
    .node-title{font-size:15px;font-weight:900;fill:#261b10;letter-spacing:.2px;}
    .node-km{font-size:10px;font-weight:900;fill:#5f401f;text-transform:uppercase;letter-spacing:.55px;}
    .node-lock{font-size:9.5px;font-weight:900;fill:rgba(38,27,16,.56);letter-spacing:.28px;}
    .map-location.done .node-lock{fill:#048d64;}

    .route-dot{
      transition:opacity .2s ease, fill .2s ease, r .2s ease;
      opacity:.7;
    }

    .route-dot.done{
      fill:#fff0b8;
      stroke:#ffffff;
      opacity:1;
      filter:drop-shadow(0 0 10px rgba(255,213,124,.35));
    }

    .snake-marker{
      transition:transform .45s cubic-bezier(.2,.8,.2,1);
      filter:drop-shadow(0 7px 10px rgba(17,20,24,.20));
    }

    .snake-marker .snake-badge{
      fill:#2b2014;
      stroke:#f2d9a4;
      stroke-width:3;
    }

    .snake-marker .snake-line{
      fill:none;
      stroke:#048d64;
      stroke-width:5;
      stroke-linecap:round;
      stroke-linejoin:round;
    }

    .snake-marker .snake-eye{fill:#f2d9a4;}

    .milestones{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:6px;
      margin-top:8px;
    }

    .milestone{
      border-radius:14px;
      border:1px solid rgba(111,83,30,.18);
      background:rgba(255,255,255,.38);
      padding:8px 6px;
      text-align:center;
      box-shadow:0 6px 14px rgba(17,20,24,.04);
    }

    .milestone-top{
      font-size:10px;
      font-weight:900;
      line-height:1.2;
      color:#2b2014;
    }

    .milestone-bottom{
      font-size:9px;
      color:rgba(43,32,20,.62);
      margin-top:3px;
      line-height:1.25;
      font-weight:800;
    }

    .milestone.done{
      border-color:rgba(4,141,100,.34);
      background:linear-gradient(135deg, rgba(4,141,100,.12), rgba(255,213,124,.24));
      box-shadow:0 0 0 1px rgba(255,255,255,.38) inset, 0 8px 18px rgba(4,141,100,.08);
    }

    .grid{
      display:grid;
      grid-template-columns:1fr;
      gap:8px;
    }

    @media (min-width:860px){
      .grid{grid-template-columns:1.08fr .92fr}
    }

    .small-title{
      font-size:14px;
      font-weight:900;
      margin-bottom:6px;
    }

    .manual-box,
    .collectables-box{
      margin-top:6px;
      padding:8px;
      border-radius:14px;
      border:1px solid var(--border);
      background:rgba(255,255,255,.03);
    }

    .manual-row{
      display:flex;
      gap:6px;
      flex-wrap:wrap;
      align-items:center;
      margin-top:6px;
    }

    .manual-row .input{
      flex:1 1 150px;
      margin-top:0;
    }

    .section-title{
      font-size:14px;
      font-weight:900;
      margin-bottom:6px;
      text-transform:uppercase;
      letter-spacing:.25px;
    }

    .collapsible-header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:8px;
      cursor:pointer;
      user-select:none;
    }

    .collapse-toggle{
      font-size:11px;
      color:var(--muted);
      font-weight:800;
      white-space:nowrap;
    }

    .collapse-content{display:none}
    .collapse-content.open{display:block}

    .session-list{
      display:flex;
      flex-direction:column;
      gap:6px;
      margin-top:8px;
    }

    .session-item{
      border:1px solid var(--border);
      background:rgba(255,255,255,.03);
      border-radius:12px;
      padding:8px;
    }

    .session-top{
      display:flex;
      justify-content:space-between;
      gap:6px;
      align-items:center;
      flex-wrap:wrap;
      font-weight:800;
      font-size:12px;
    }

    .session-meta{
      margin-top:5px;
      color:var(--muted);
      font-size:11px;
      line-height:1.4;
    }

    .session-badge{
      display:inline-block;
      margin-top:6px;
      padding:4px 8px;
      border-radius:999px;
      border:1px solid var(--border);
      background:rgba(17,20,24,.04);
      font-size:10px;
      font-weight:900;
    }

    .badge-log{
      color:#0a7b58;
      border-color:rgba(4,141,100,.18);
      background:rgba(4,141,100,.08);
    }

    .footer-actions{
      margin-top:8px;
      display:flex;
      gap:6px;
      flex-wrap:wrap;
    }

    .footer-actions .btn{
      flex:1 1 130px;
      width:auto;
      margin-top:0;
      padding:10px 12px;
    }

    .certificate-row{margin-top:10px}
    .certificate-row .btn{
      width:100%;
      padding:12px 14px;
      font-size:15px;
    }

    .help{
      margin-top:8px;
      color:var(--muted);
      font-size:10px;
      text-align:center;
      line-height:1.35;
    }

    .login-help{
      margin-top:10px;
      font-size:11px;
      color:var(--muted);
      line-height:1.4;
    }

    .login-help a{
      color:var(--green);
      text-decoration:none;
      font-weight:700;
    }

    select.input{appearance:none}

    .collectables-header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      padding:10px 12px;
      border-radius:12px;
      border:1px solid rgba(255,255,255,.08);
      background:linear-gradient(90deg, rgba(130,0,255,0.08), rgba(255,0,200,0.08));
      cursor:pointer;
      user-select:none;
    }

    .collectables-header .section-title{margin:0}

    .collectables-meta{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:6px 10px;
      border-radius:999px;
      background:#ffffff;
      border:1px solid rgba(4,141,100,.25);
      color:#048d64;
      font-size:11px;
      font-weight:900;
      white-space:nowrap;
    }

    .collectables-grid{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:8px;
      margin-top:8px;
    }

    .collectable-card{
      position:relative;
      border:1px solid var(--border);
      border-radius:12px;
      overflow:hidden;
      background:#f5f7fa;
      min-height:130px;
    }

    .collectable-card img{
      display:block;
      width:100%;
      height:100%;
      object-fit:cover;
      aspect-ratio:3 / 4;
    }

    .collectable-card.locked img{
      filter:grayscale(1) brightness(.35) blur(1px);
      transform:scale(1.03);
    }

    .collectable-overlay{
      position:absolute;
      inset:0;
      display:flex;
      flex-direction:column;
      justify-content:center;
      align-items:center;
      gap:4px;
      background:rgba(17,20,24,.16);
      text-align:center;
      padding:8px;
    }

    .collectable-lock{
      font-size:24px;
      line-height:1;
    }

    .collectable-name{
      font-size:11px;
      font-weight:900;
      letter-spacing:.3px;
    }

    .collectable-status{
      font-size:10px;
      color:var(--muted);
      line-height:1.25;
    }

    .collectable-card.unlocked .collectable-overlay{
      background:linear-gradient(180deg, rgba(255,255,255,.10), rgba(17,20,24,.18));
      justify-content:flex-end;
      align-items:flex-start;
    }

    .collectable-card.unlocked .collectable-status{
      color:var(--green);
      font-weight:800;
    }

    .collectable-card.unlocked{cursor:pointer}

    .unlock-image,
    .card-popup-image{
      display:block;
      max-width:240px;
      width:100%;
      margin:10px auto 8px;
      border-radius:14px;
      border:1px solid var(--border);
      background:rgba(255,255,255,.03);
    }

    .overlay{
      position:fixed;
      inset:0;
      background:rgba(17,20,24,.68);
      display:none;
      justify-content:center;
      align-items:center;
      padding:12px;
      z-index:9999;
    }

    .overlay.show{display:flex}

    .modal-card{
      width:min(94vw, 520px);
      background:var(--panel);
      border:1px solid var(--border);
      border-radius:18px;
      padding:14px 12px;
      text-align:center;
      box-shadow:0 20px 60px rgba(17,20,24,.18);
      max-height:92vh;
      overflow:auto;
    }

    .modal-title{
      font-size:24px;
      font-weight:900;
      margin-bottom:6px;
    }

    .modal-copy{
      color:var(--muted);
      line-height:1.4;
      font-size:12px;
      margin-bottom:10px;
    }

    .pill{
      padding:7px 9px;
      border-radius:999px;
      border:1px solid var(--border);
      background:rgba(17,20,24,.04);
      font-size:11px;
      font-weight:800;
    }

    .danger-warning{
      color:#8c2f2f;
      border-color:rgba(166,45,45,.45);
      background:rgba(166,45,45,.10);
    }

    .confirm-input{
      text-transform:uppercase;
      letter-spacing:.8px;
      font-weight:900;
      text-align:center;
    }

    .confirm-input::placeholder{
      text-transform:none;
      letter-spacing:0;
      font-weight:600;
    }

    @media (max-width:420px){
      .milestones{grid-template-columns:repeat(2,1fr)}
    }

    .collectable-card.locked img{
      filter:grayscale(1) brightness(.55) blur(14px);
      transform:scale(1.08);
    }

    .collectable-card.locked::after{
      content:"";
      position:absolute;
      inset:0;
      background:
        radial-gradient(circle at 50% 38%, rgba(4,141,100,.10), transparent 28%),
        radial-gradient(circle at 50% 62%, rgba(230,184,74,.10), transparent 28%),
        linear-gradient(180deg, rgba(255,255,255,.20), rgba(17,20,24,.42));
      pointer-events:none;
    }

    .reveal-shell{
      position:relative;
      max-width:240px;
      margin:10px auto 8px;
    }

    .reveal-card{
      display:block;
      width:100%;
      border-radius:14px;
      border:1px solid var(--border);
