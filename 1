.deadman-card-face strong{
  font-size:1.55rem;
  font-weight:1000;
  letter-spacing:.08em;
}
.deadman-card-face small{
  color:#a99eb4;
  font-weight:1000;
  letter-spacing:.12em;
}
.deadman-vault-card.locked{
  filter:grayscale(1) brightness(.62);
}
.deadman-vault-card.locked::after{
  content:"LOCKED";
  position:absolute;
  left:50%;
  bottom:12px;
  transform:translateX(-50%);
  z-index:3;
  color:#a99eb4;
  font-size:.7rem;
  font-weight:1000;
  letter-spacing:.18em;
}
.deadman-vault-card.unlocked::after{
  content:"TAP TO VIEW";
  position:absolute;
  left:50%;
  bottom:12px;
  transform:translateX(-50%);
  z-index:3;
  color:#a56bff;
  font-size:.68rem;
  font-weight:1000;
  letter-spacing:.14em;
}
.deadman-vault-note{
  margin-top:12px;
  color:#a99eb4;
  font-size:.82rem;
  line-height:1.4;
