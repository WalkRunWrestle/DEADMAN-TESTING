    function getUrlToken(){
      return new URLSearchParams(window.location.search).get("wrw_token");
    }

    function getUserFromStoredSupabaseSession(){
      try {
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (!key || !key.includes("supabase") && !key.includes("auth-token")) continue;

          const raw = localStorage.getItem(key);
          if (!raw) continue;

          let parsed;
          try { parsed = JSON.parse(raw); } catch(e) { continue; }

          const user = parsed?.user || parsed?.currentSession?.user || parsed?.session?.user;
          const expiresAt = parsed?.expires_at || parsed?.currentSession?.expires_at || parsed?.session?.expires_at;

          if (user && user.id) {
            if (expiresAt && Number(expiresAt) * 1000 < Date.now()) continue;
            return { id: user.id, email: user.email || "WRW account" };
          }
        }
      } catch (err) {
        console.log("Stored Supabase session check failed:", err);
      }
      return null;
    }

    async function withTimeout(promise, ms){
      return Promise.race([
        promise,
        new Promise((_, reject) => setTimeout(() => reject(new Error("Supabase check timed out")), ms))
      ]);
    }

    async function getLinkedUserFromSupabase(){
      try {
        if(WRW_DIRECT_USER_ID){
          return { id: WRW_DIRECT_USER_ID, email: "WRW Hub linked" };
        }

        const token = WRW_BRIDGE_TOKEN || getUrlToken();
        if(token){
          // We do not need to read the token table from the browser.
          // The save RPC will validate the token securely inside Supabase.
          return { id: "bridge-token", email: "WRW Hub linked" };
        }

        const storedUser = getUserFromStoredSupabaseSession();
        if (storedUser) return storedUser;

        const sessionResult = await withTimeout(sb.auth.getSession(), 5000);
        const user = sessionResult.data && sessionResult.data.session ? sessionResult.data.session.user : null;
        if (user) return { id: user.id, email: user.email || "WRW account" };
      } catch (err) {
        console.log("WRW account check failed:", err);
      }

      return null;
    }

    async function loadCloudProgress(){
      if (!wrwUserId || wrwUserId === "bridge-token") return null;

      const result = await withTimeout(
        sb
          .from("user_progress")
          .select("distance_done")
          .eq("user_id", wrwUserId)
          .eq("race_id", RUN_ID)
          .maybeSingle(),
        5000
      );

      if (result.error) {
        console.log("Cloud progress load failed:", result.error.message);
        return null;
      }

      return result.data && result.data.distance_done !== null ? Number(result.data.distance_done) : 0;
    }


    async function upsertProgressWithHubToken(distanceDone){
      const token = WRW_BRIDGE_TOKEN || getUrlToken();
      if(!token || !WRW_DIRECT_USER_ID){
        return { ok:false, error:"missing token or user id" };
      }

      const response = await fetch(SUPABASE_URL + "/rest/v1/user_progress?on_conflict=user_id,race_id", {
        method: "POST",
        headers: {
          "apikey": SUPABASE_ANON_KEY,
          "Authorization": "Bearer " + token,
          "Content-Type": "application/json",
          "Prefer": "resolution=merge-duplicates,return=representation"
        },
        body: JSON.stringify({
          user_id: WRW_DIRECT_USER_ID,
          race_id: RUN_ID,
          distance_done: distanceDone
        })
      });

      const text = await response.text();
      if(!response.ok){
        return { ok:false, error:text || ("HTTP " + response.status) };
      }
      return { ok:true, data:text };
    }

    async function verifyHubDistance(){
      if(!WRW_DIRECT_USER_ID) return null;
      const token = WRW_BRIDGE_TOKEN || getUrlToken();
      const headers = { "apikey": SUPABASE_ANON_KEY };
      if(token) headers["Authorization"] = "Bearer " + token;
      const url = SUPABASE_URL + "/rest/v1/user_progress?select=distance_done&user_id=eq." + encodeURIComponent(WRW_DIRECT_USER_ID) + "&race_id=eq." + encodeURIComponent(RUN_ID);
      const response = await fetch(url, { headers });
      const text = await response.text();
      if(!response.ok) return { ok:false, error:text || ("HTTP " + response.status) };
      try{
        const rows = JSON.parse(text);
        return { ok:true, distance: rows && rows[0] ? Number(rows[0].distance_done || 0) : 0 };
      }catch(e){
        return { ok:false, error:"verify JSON parse failed" };
      }
    }

    async function saveCloudProgress(){
      updateSyncDebugMode();
      const distanceDone = Number(getTotalKm().toFixed(2));
      addSyncDebug("saveCloudProgress start", distanceDone.toFixed(2) + " km");

      try {
        /*
          Bridge-token sync:
          The Hub creates a short-lived token for the logged-in user and opens this app with:
          ?wrw_token=...
          Deadman does NOT need to share the browser login session.
          It calls the Supabase RPC, and Supabase links the progress to the correct Hub user.
        */
        if(WRW_DIRECT_USER_ID){
          addSyncDebug("sync route", "token REST upsert");
          addSyncDebug("target_user_id", WRW_DIRECT_USER_ID);

          const upsert = await upsertProgressWithHubToken(distanceDone);
          if(!upsert.ok){
            addSyncDebug("token REST upsert error", upsert.error);
            console.log("Token REST upsert failed:", upsert.error);
            cloudReady = false;
            setStatus("Saved on this device. Hub sync failed: " + upsert.error, "status-saved");
            return;
          }

          addSyncDebug("token REST upsert", "success");
          const verify = await verifyHubDistance();
          if(verify && verify.ok){
            addSyncDebug("hub distance after save", verify.distance.toFixed(2) + " km");
          } else if(verify){
            addSyncDebug("verify error", verify.error);
          }

          cloudReady = true;
          setStatus("Run saved and synced to WRW Hub · " + distanceDone.toFixed(2) + " km", "status-saved");
          return;
        }

        const token = WRW_BRIDGE_TOKEN || getUrlToken();

        if(token){
          addSyncDebug("sync route", "sync_progress_with_token");
          addSyncDebug("bridge_token", "present");
          const result = await sb.rpc("sync_progress_with_token", {
            bridge_token: token,
            race_key: RUN_ID,
            new_distance: distanceDone
          });

          if(result.error){
            addSyncDebug("sync_progress_with_token error", result.error.message || result.error);
            console.log("Bridge sync failed:", result.error);
            cloudReady = false;
            setStatus("Saved on this device. Hub sync failed: " + result.error.message, "status-saved");
            return;
          }

          cloudReady = true;
          addSyncDebug("sync_progress_with_token", "success");
          setStatus("Run saved and synced to WRW Hub · " + distanceDone.toFixed(2) + " km", "status-saved");
          return;
        }

        /*
          Fallback only: if this app is somehow opened with a real Supabase auth session,
          save directly. The main live flow should be the bridge token above.
        */
        const sessionResult = await sb.auth.getSession();
        const user = sessionResult.data && sessionResult.data.session ? sessionResult.data.session.user : null;

        if(!user){
          addSyncDebug("fallback auth session", "none - app was not opened from Hub or no shared login");
          cloudReady = false;
          setStatus("Saved on this device. Open Deadman from the Hub to sync progress.", "status-saved");
          return;
        }

        wrwUserId = user.id;
        wrwUserEmail = user.email || "WRW account";

        addSyncDebug("sync route", "direct user_progress upsert");
        addSyncDebug("auth user", user.email || user.id);

        const result = await sb
          .from("user_progress")
          .upsert({
            user_id: user.id,
            race_id: RUN_ID,
            distance_done: distanceDone
          }, { onConflict: "user_id,race_id" });

        if(result.error){
          addSyncDebug("direct upsert error", result.error.message || result.error);
          console.log("Direct cloud progress save failed:", result.error);
          cloudReady = false;
          setStatus("Saved on this device. Cloud sync failed: " + result.error.message, "status-saved");
          return;
        }

        cloudReady = true;
        addSyncDebug("direct upsert", "success");
        setStatus("Run saved and synced to WRW Hub · " + distanceDone.toFixed(2) + " km", "status-saved");
      } catch(err) {
        console.log("Cloud progress save crashed:", err);
        addSyncDebug("saveCloudProgress crash", err && err.message ? err.message : err);
        cloudReady = false;
        setStatus("Saved on this device. Cloud sync failed: " + (err && err.message ? err.message : err), "status-saved");
      }
    }

    async function syncInitialCloudProgress(){
      if (!wrwUserId || initialSyncDone) return;
      initialSyncDone = true;

      const cloudTotal = await loadCloudProgress();
      if (cloudTotal === null) return;

      const localTotal = getTotalKm();

      if (cloudTotal > 0 && localTotal === 0) {
        saveSessions([{ date: new Date().toISOString(), distanceKm: cloudTotal, source: "WRW Hub sync" }]);
      } else if (localTotal > cloudTotal) {
        await saveCloudProgress();
      }
    }

    function setStatus(text, className){
      statusBar.textContent = text;
      statusBar.className = `status-bar ${className}`;
    }

    function toggleSection(contentEl, labelEl){
      const open = contentEl.classList.contains("open");
      contentEl.classList.toggle("open", !open);
      if (labelEl) labelEl.textContent = open ? "Show" : "Hide";
      if (contentEl === collectablesContent) updateCollectablesHeader();
    }

    function openResetConfirm(){
      resetConfirmInput.value = "";
      confirmResetBtn.disabled = true;
      resetConfirmOverlay.style.display = "flex";
      resetConfirmOverlay.classList.add("show");
      resetConfirmOverlay.setAttribute("aria-hidden", "false");
      setTimeout(() => resetConfirmInput.focus(), 50);
    }

    function closeResetConfirm(){
      if (!resetConfirmOverlay) return;
      resetConfirmOverlay.classList.remove("show");
      resetConfirmOverlay.style.display = "none";
      resetConfirmOverlay.setAttribute("aria-hidden", "true");
      if (resetConfirmInput) resetConfirmInput.value = "";
      if (confirmResetBtn) confirmResetBtn.disabled = true;
      document.body.style.overflow = "";
    }

    async function performResetProgress(){
      // Close the reset popup immediately so the UI never gets stuck while reset/sync runs.
      closeResetConfirm();
      try {
      localStorage.removeItem(STORAGE_KEY);
      localStorage.removeItem(COMPLETE_KEY);
      localStorage.removeItem(COLLECTABLES_KEY);
      const vault = getVaultState();
      if (vault.runs && vault.runs[RUN_ID]) {
        delete vault.runs[RUN_ID];
        saveVaultState(vault);
      }
      renderSessions();
      renderCollectables();
      updateOverallProgress();
      updateCollectablesHeader();
      hideFinishPopup();
      closeResetConfirm();
      manualDistanceInput.value = "";
      manualDateInput.value = new Date().toISOString().split("T")[0];
      setStatus("Ready to log progress", "status-ready");
      if (wrwUserId && wrwUserId !== "bridge-token") {
        const result = await sb
          .from("user_progress")
          .delete()
          .eq("user_id", wrwUserId)
          .eq("race_id", RUN_ID);
        if (result.error) console.log("Cloud reset failed:", result.error.message);
      }
      setStatus(cloudReady ? "Progress reset on this device and WRW Hub." : "Progress reset on this device.", "status-ready");
      setTimeout(() => {
        const mapShell = document.getElementById("deadmanMapShell");
        if (mapShell) mapShell.scrollIntoView({ behavior:"smooth", block:"center" });
      }, 150);
      } catch (err) {
        console.log("Reset failed:", err);
        closeResetConfirm();
        setStatus("Reset attempted. If anything looks wrong, refresh and try again.", "status-ready");
      }
    }

    function getCollectableState(){
      const saved = JSON.parse(localStorage.getItem(COLLECTABLES_KEY) || "{}");
      const legacyMap = {
        card1: "RS25",
        card2: "RS50",
        card3: "RS75",
        card4: "RS100"
      };
      const state = {};
      COLLECTABLE_DEFS.forEach(card => {
        state[card.id] = !!saved[card.id];
      });

      Object.entries(legacyMap).forEach(([legacyId, newId]) => {
        if (saved[legacyId]) state[newId] = true;
      });

      return state;
    }

    function getVaultState(){
      const raw = JSON.parse(localStorage.getItem(WRW_VAULT_KEY) || "{}");
      if (!raw || typeof raw !== "object" || Array.isArray(raw)) return { version: 1, runs: {} };
      if (!raw.version) raw.version = 1;
      if (!raw.runs || typeof raw.runs !== "object" || Array.isArray(raw.runs)) {
        const legacyRuns = {};
        Object.keys(raw).forEach(key => {
          if (key !== "version" && raw[key] && typeof raw[key] === "object" && !Array.isArray(raw[key])) {
            legacyRuns[key] = raw[key];
          }
        });
        raw.runs = legacyRuns;
      }
      return raw;
    }

    function saveVaultState(vault){
      localStorage.setItem(WRW_VAULT_KEY, JSON.stringify(vault));
    }

    function getRunVault(){
      const vault = getVaultState();
      if (!vault.runs[RUN_ID]) {
        vault.runs[RUN_ID] = {
          runId: RUN_ID,
          runName: "The Deadman",
          targetKm: TARGET_KM,
          totalKm: 0,
          completed: false,
          totalRuns: 0,
          cards: {},
          unlockedCards: [],
          updatedAt: new Date().toISOString()
        };
      }
      return { vault, runVault: vault.runs[RUN_ID] };
    }

    function syncRunToVault(){
      const { vault, runVault } = getRunVault();
      const sessions = getSessions();
      const totalKm = sessions.reduce((sum, session) => sum + (session.distanceKm || 0), 0);
      const collectableState = getCollectableState();

      runVault.runId = RUN_ID;
      runVault.runName = "The Deadman";
      runVault.targetKm = TARGET_KM;
      runVault.totalKm = Number(totalKm.toFixed(2));
      runVault.completed = totalKm >= TARGET_KM;
      runVault.totalRuns = sessions.length;
      runVault.updatedAt = new Date().toISOString();
      runVault.cards = runVault.cards || {};

      COLLECTABLE_DEFS.forEach(card => {
        if (collectableState[card.id]) {
          runVault.cards[card.id] = {
            id: card.id,
            name: card.name,
            label: card.label,
            file: card.file,
            km: card.km,
            unlocked: true,
            unlockedAt: runVault.cards[card.id]?.unlockedAt || new Date().toISOString()
          };
        }
      });

      runVault.unlockedCards = COLLECTABLE_DEFS
        .filter(card => !!runVault.cards[card.id]?.unlocked)
        .map(card => card.id);

      saveVaultState(vault);
    }

    function saveCollectableState(state){
      localStorage.setItem(COLLECTABLES_KEY, JSON.stringify(state));
      syncRunToVault();
    }

