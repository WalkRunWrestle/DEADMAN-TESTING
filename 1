<script>
(function(){
  const savedKey = "wrw_deadman_saved_runs_v1";
  const mainKey = "wrw_deadman_main_21k_progress_v2";
  const finalKey = "wrw_deadman_final_1k_progress_v2";

  function runs(){
    try{return JSON.parse(localStorage.getItem(savedKey) || "[]") || [];}catch(e){return [];}
  }

  function formatTime(iso){
    try{
      const d = new Date(iso);
      if(!isNaN(d.getTime())) return d.toLocaleString("en-GB",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"});
    }catch(e){}
    return "—";
  }

  function updateEpicStats(){
    const list = runs();
    const total = list.reduce((a,r)=>a + (Number(r.km || r.distance || 0) || 0),0);
    const biggest = list.reduce((a,r)=>Math.max(a, Number(r.km || r.distance || 0) || 0),0);
    const last = list.length ? list[list.length-1] : null;

    const sr = document.getElementById("deadmanStatRuns");
    const sk = document.getElementById("deadmanStatKm");
    const sl = document.getElementById("deadmanStatLast");
    const sf = document.getElementById("deadmanStatFastest");
    if(sr) sr.textContent = String(list.length);
    if(sk) sk.textContent = total.toFixed(2);
    if(sl) sl.textContent = last ? formatTime(last.time || last.date || last.createdAt) : "—";
    if(sf) sf.textContent = biggest ? biggest.toFixed(2) + "K" : "—";
  }

  // upgrade saved run storage to include exact time every time
  const oldSave = window.deadmanSaveRunEntry;
  window.deadmanSaveRunEntry = function(km,type){
    km = Number(km) || 0;
    if(km <= 0) return;

    let list = runs();
    list.push({
      km: km,
      type: type || "streak",
      date: new Date().toISOString(),
      time: new Date().toISOString()
    });
    localStorage.setItem(savedKey, JSON.stringify(list));

    if(typeof window.deadmanRenderSavedRuns === "function") window.deadmanRenderSavedRuns();
    updateEpicStats();
  };

  // make saved run renderer show time if it exists
  const oldRender = window.deadmanRenderSavedRuns;
  window.deadmanRenderSavedRuns = function(){
    const list = document.getElementById("deadmanSavedRunsList");
    if(!list) return;
    const data = runs();
    if(!data.length){
      list.innerHTML = '<div class="deadman-empty-runs">No runs saved yet.</div>';
      updateEpicStats();
      return;
    }
    list.innerHTML = data.slice().reverse().map(function(run, reverseIndex){
      const index = data.length - 1 - reverseIndex;
      const km = Number(run.km || run.distance || 0) || 0;
      const type = run.type === "final" ? "Final 1K" : "Streak";
      const when = formatTime(run.time || run.date || run.createdAt);
      return `
        <div class="deadman-run-row">
          <div class="deadman-run-main">
            <div class="deadman-run-title">${type} · ${km.toFixed(2)} km</div>
            <div class="deadman-run-meta">Saved run ${index + 1} · ${when}</div>
          </div>
          <button class="deadman-run-delete" type="button" onclick="deadmanDeleteRun(${index})">DELETE</button>
        </div>
      `;
    }).join("");
    updateEpicStats();
  };

  function flashLightning(){
    const el = document.getElementById("deadmanLightning");
    if(!el) return;
    el.classList.remove("flash");
    void el.offsetWidth;
    el.classList.add("flash");
  }

  let finalWasUnlocked = localStorage.getItem("wrw_deadman_final_unlocked_seen_v1") === "yes";
  function watchUnlock(){
    const main = Number(localStorage.getItem(mainKey) || 0);
    if(main >= 21 && !finalWasUnlocked){
      finalWasUnlocked = true;
      localStorage.setItem("wrw_deadman_final_unlocked_seen_v1","yes");
      flashLightning();
      setTimeout(function(){
        if(typeof deadmanOpenFinal === "function") deadmanOpenFinal();
      },650);
    }
    if(main < 21 && finalWasUnlocked){
      finalWasUnlocked = false;
      localStorage.setItem("wrw_deadman_final_unlocked_seen_v1","no");
    }
  }

  function addAshTrail(){
    const frame = document.querySelector(".deadman-map-frame");
    const orb = document.getElementById("deadmanCleanOrb");
    if(!frame || !orb) return;

    const rect = frame.getBoundingClientRect();
    const o = orb.getBoundingClientRect();
    const ash = document.createElement("span");
    ash.className = "deadman-ash";
    ash.style.left = (o.left - rect.left + o.width/2) + "px";
    ash.style.top = (o.top - rect.top + o.height/2) + "px";
    frame.appendChild(ash);
    setTimeout(()=>ash.remove(),1700);
  }

  function drawFootprints(){
    const frame = document.querySelector(".deadman-map-frame");
    if(!frame || frame.querySelector(".deadman-footprint")) return;
    for(let i=0;i<9;i++){
      const fp=document.createElement("span");
      fp.className="deadman-footprint";
      fp.style.left=(49 + (i%2 ? 2 : -2)) + "%";
      fp.style.top=(88 - i*7.5) + "%";
      fp.style.opacity=String(.18 + i*.055);
      frame.appendChild(fp);
    }
  }
window.addEventListener("load", function(){
    setTimeout(function(){
      updateEpicStats();
      drawFootprints();
      watchUnlock();
    },600);
  });

  setInterval(function(){
    updateEpicStats();
    watchUnlock();
    addAshTrail();
  },1300);
})();
</script>





